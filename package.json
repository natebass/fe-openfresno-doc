{
  "name": "fe-openfresno-doc",
  "version": "1.2.0",
  "private": false,
  "description": "Storybook documentation for the Open Fresno website.",
  "keywords": [
    "California",
    "Fresno",
    "civic",
    "documentation",
    "meetup",
    "nextjs",
    "playwright",
    "storybook",
    "tailwind",
    "vitest"
  ],
  "homepage": "https://github.com/openfresno/fe-openfresno-doc#readme",
  "bugs": {
    "url": "https://github.com/openfresno/fe-openfresno-doc/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Open Fresno",
    "email": "hello@openfresno.org",
    "url": "https://openfresno.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openfresno/fe-openfresno-doc.git"
  },
  "type": "module",
  "imports": {
    "#.storybook/*": "./.storybook/*"
  },
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "next build",
    "build:storybook": "storybook build",
    "test": "vitest",
    "test:unit": "vitest --project=unit",
    "test:sb": "vitest --project=storybook",
    "test:ui": "vitest --ui",
    "test:debug": "playwright test --project=chromium --headed --debug",
    "storybook": "storybook dev -p 6006",
    "storybook:ci": "storybook dev --no-open -p 6006",
    "storybook:doctor": "storybook doctor --package-manager pnpm"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.4",
    "keen-slider": "^6.8.6",
    "moment": "^2.30.1",
    "next": "^16.3.4",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "swr": "^2.5.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4"
  ],
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    },
    "runtime": { "name": "node", "version": "^24.0.0", "onFail": "download" }
  }
}
